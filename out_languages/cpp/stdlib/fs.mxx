module;  // Global module fragment

#include <filesystem>
#include <fstream>
#include <string>
#include <vector>
#include <sstream>
#include <optional>
#include <stdexcept>
#include <chrono>

export module typoly_std_fs;

import typoly_std_builtin_basic_types;

export namespace typoly_std_fs {

using namespace typoly_std_builtin_basic_types;

// Options structures
struct ReadFileOptions {
    String encoding = String("utf8");
};

struct WriteFileOptions {
    String encoding = String("utf8");
    String flag = String("w");
    int mode = 0666;
};

struct AppendFileOptions {
    String encoding = String("utf8");
    int mode = 0666;
};

struct MkdirOptions {
    bool recursive = false;
    int mode = 0777;
};

struct RmOptions {
    bool recursive = false;
    bool force = false;
};

// Helper to convert String to path
inline std::filesystem::path toPath(const String& s) {
    return std::filesystem::path(s.value);
}

// Stats structure
struct Stats {
    bool isFile() const { return type == FileType::File; }
    bool isDirectory() const { return type == FileType::Directory; }
    bool isSymbolicLink() const { return type == FileType::Symlink; }
    
    int64_t size = 0;
    int64_t mtimeMs = 0;
    int64_t ctimeMs = 0;
    int64_t atimeMs = 0;
    
    enum class FileType { File, Directory, Symlink, Other };
    FileType type = FileType::Other;
};

// Forward declarations for encoding variants
inline String readFileSyncBase64(const String& path);
inline String readFileSyncHex(const String& path);
inline Vector<double> readFileSyncBinary(const String& path);
inline void writeFileSyncBase64(const String& path, const String& data);
inline void writeFileSyncHex(const String& path, const String& data);
inline void writeFileSyncBinary(const String& path, const Vector<double>& data);
inline void appendFileSyncBinary(const String& path, const String& data);

// existsSync
inline bool existsSync(const String& path) {
    return std::filesystem::exists(toPath(path));
}

inline bool existsSync(const char* path) {
    return std::filesystem::exists(path);
}

// readFileSync
inline String readFileSync(const String& path) {
    std::ifstream file(path.value);
    if (!file.is_open()) {
        throw std::runtime_error("ENOENT: no such file or directory, open '" + path.value + "'");
    }
    std::stringstream buffer;
    buffer << file.rdbuf();
    return String(buffer.str());
}

inline String readFileSync(const char* path) {
    return readFileSync(String(path));
}

inline String readFileSync(const String& path, const String& encoding) {
    if (encoding.value == "base64") return readFileSyncBase64(path);
    if (encoding.value == "hex") return readFileSyncHex(path);
    return readFileSync(path);
}

inline String readFileSyncBase64(const String& path) {
    std::ifstream file(path.value, std::ios::binary);
    if (!file.is_open()) {
        throw std::runtime_error("ENOENT: no such file or directory, open '" + path.value + "'");
    }
    std::string content((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
    static const char base64_chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    std::string result;
    int i = 0;
    unsigned char char_array_3[3];
    unsigned char char_array_4[4];
    for (char c : content) {
        char_array_3[i++] = c;
        if (i == 3) {
            char_array_4[0] = (char_array_3[0] & 0xfc) >> 2;
            char_array_4[1] = ((char_array_3[0] & 0x03) << 4) + ((char_array_3[1] & 0xf0) >> 4);
            char_array_4[2] = ((char_array_3[1] & 0x0f) << 2) + ((char_array_3[2] & 0xc0) >> 6);
            char_array_4[3] = char_array_3[2] & 0x3f;
            for (i = 0; i < 4; i++) result += base64_chars[char_array_4[i]];
            i = 0;
        }
    }
    if (i) {
        for (int j = i; j < 3; j++) char_array_3[j] = '\0';
        char_array_4[0] = (char_array_3[0] & 0xfc) >> 2;
        char_array_4[1] = ((char_array_3[0] & 0x03) << 4) + ((char_array_3[1] & 0xf0) >> 4);
        char_array_4[2] = ((char_array_3[1] & 0x0f) << 2) + ((char_array_3[2] & 0xc0) >> 6);
        for (int j = 0; j < i + 1; j++) result += base64_chars[char_array_4[j]];
        while (i++ < 3) result += '=';
    }
    return String(result);
}

inline String readFileSyncHex(const String& path) {
    std::ifstream file(path.value, std::ios::binary);
    if (!file.is_open()) {
        throw std::runtime_error("ENOENT: no such file or directory, open '" + path.value + "'");
    }
    std::string content((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
    std::string result;
    for (unsigned char c : content) {
        char hex[3];
        snprintf(hex, sizeof(hex), "%02x", c);
        result += hex;
    }
    return String(result);
}

inline Vector<double> readFileSyncBinary(const String& path) {
    std::ifstream file(path.value, std::ios::binary);
    if (!file.is_open()) {
        throw std::runtime_error("ENOENT: no such file or directory, open '" + path.value + "'");
    }
    std::string content((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
    Vector<double> result;
    for (unsigned char c : content) {
        result.push(static_cast<double>(c));
    }
    return result;
}

// writeFileSync
inline void writeFileSync(const String& path, const String& data) {
    std::ofstream file(path.value);
    if (!file.is_open()) {
        throw std::runtime_error("ENOENT: no such file or directory, open '" + path.value + "'");
    }
    file << data.value;
}

inline void writeFileSync(const char* path, const char* data) {
    writeFileSync(String(path), String(data));
}

inline void writeFileSync(const String& path, const char* data) {
    writeFileSync(path, String(data));
}

inline void writeFileSync(const char* path, const String& data) {
    writeFileSync(String(path), data);
}

inline void writeFileSync(const String& path, const String& data, const String& encoding) {
    if (encoding.value == "base64") writeFileSyncBase64(path, data);
    else if (encoding.value == "hex") writeFileSyncHex(path, data);
    else writeFileSync(path, data);
}

inline void writeFileSyncBase64(const String& path, const String& data) {
    static const std::string base64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    std::string result;
    int i = 0;
    unsigned char char_array_4[4], char_array_3[3];
    for (char c : data.value) {
        if (c == '=') break;
        auto pos = base64_chars.find(c);
        if (pos == std::string::npos) continue;
        char_array_4[i++] = pos;
        if (i == 4) {
            char_array_3[0] = (char_array_4[0] << 2) + ((char_array_4[1] & 0x30) >> 4);
            char_array_3[1] = ((char_array_4[1] & 0xf) << 4) + ((char_array_4[2] & 0x3c) >> 2);
            char_array_3[2] = ((char_array_4[2] & 0x3) << 6) + char_array_4[3];
            for (i = 0; i < 3; i++) result += char_array_3[i];
            i = 0;
        }
    }
    if (i) {
        for (int j = i; j < 4; j++) char_array_4[j] = 0;
        char_array_3[0] = (char_array_4[0] << 2) + ((char_array_4[1] & 0x30) >> 4);
        char_array_3[1] = ((char_array_4[1] & 0xf) << 4) + ((char_array_4[2] & 0x3c) >> 2);
        char_array_3[2] = ((char_array_4[2] & 0x3) << 6) + char_array_4[3];
        for (int j = 0; j < i - 1; j++) result += char_array_3[j];
    }
    std::ofstream file(path.value);
    if (!file.is_open()) {
        throw std::runtime_error("ENOENT: no such file or directory, open '" + path.value + "'");
    }
    file << result;
}

inline void writeFileSyncHex(const String& path, const String& data) {
    std::string result;
    for (size_t i = 0; i + 1 < data.value.length(); i += 2) {
        unsigned int byte;
        std::istringstream(data.value.substr(i, 2)) >> std::hex >> byte;
        result += static_cast<char>(byte);
    }
    std::ofstream file(path.value);
    if (!file.is_open()) {
        throw std::runtime_error("ENOENT: no such file or directory, open '" + path.value + "'");
    }
    file << result;
}

inline void writeFileSyncBinary(const String& path, const Vector<double>& data) {
    std::ofstream file(path.value, std::ios::binary);
    if (!file.is_open()) {
        throw std::runtime_error("ENOENT: no such file or directory, open '" + path.value + "'");
    }
    for (size_t i = 0; i < data.length(); i++) {
        char c = static_cast<char>(data[i]);
        file.write(&c, 1);
    }
}

// appendFileSync
inline void appendFileSync(const String& path, const String& data) {
    std::ofstream file(path.value, std::ios::app);
    if (!file.is_open()) {
        throw std::runtime_error("ENOENT: no such file or directory, open '" + path.value + "'");
    }
    file << data.value;
}

inline void appendFileSync(const char* path, const char* data) {
    appendFileSync(String(path), String(data));
}

inline void appendFileSync(const String& path, const char* data) {
    appendFileSync(path, String(data));
}

inline void appendFileSync(const char* path, const String& data) {
    appendFileSync(String(path), data);
}

inline void appendFileSync(const String& path, const String& data, const String& encoding) {
    if (encoding.value == "binary") appendFileSyncBinary(path, data);
    else appendFileSync(path, data);
}

inline void appendFileSyncBinary(const String& path, const String& data) {
    std::ofstream file(path.value, std::ios::app | std::ios::binary);
    if (!file.is_open()) {
        throw std::runtime_error("ENOENT: no such file or directory, open '" + path.value + "'");
    }
    file << data.value;
}

// mkdirSync
inline void mkdirSync(const String& path) {
    std::filesystem::create_directories(toPath(path));
}

inline void mkdirSync(const char* path) {
    mkdirSync(String(path));
}

// rmSync
inline void rmSync(const String& path) {
    auto p = toPath(path);
    if (std::filesystem::is_directory(p)) {
        std::filesystem::remove_all(p);
    } else {
        std::filesystem::remove(p);
    }
}

inline void rmSync(const char* path) {
    rmSync(String(path));
}

// accessSync
inline void accessSync(const String& path, int mode = 0) {
    auto p = toPath(path);
    if (!std::filesystem::exists(p)) {
        throw std::runtime_error("ENOENT: no such file or directory, access '" + path.value + "'");
    }
}

// chmodSync
inline void chmodSync(const String& path, int mode) {
    auto p = toPath(path);
    if (!std::filesystem::exists(p)) {
        throw std::runtime_error("ENOENT: no such file or directory, chmod '" + path.value + "'");
    }
}

// realpathSync
inline String realpathSync(const String& path) {
    auto p = std::filesystem::canonical(toPath(path));
    return String(p.string());
}

// lstatSync
inline Stats lstatSync(const String& path) {
    auto p = toPath(path);
    if (!std::filesystem::exists(p)) {
        throw std::runtime_error("ENOENT: no such file or directory, lstat '" + path.value + "'");
    }
    Stats stats;
    auto status = std::filesystem::status(p);
    if (std::filesystem::is_regular_file(status)) stats.type = Stats::FileType::File;
    else if (std::filesystem::is_directory(status)) stats.type = Stats::FileType::Directory;
    else if (std::filesystem::is_symlink(status)) stats.type = Stats::FileType::Symlink;
    else stats.type = Stats::FileType::Other;
    return stats;
}

// renameSync
inline void renameSync(const String& oldPath, const String& newPath) {
    std::filesystem::rename(toPath(oldPath), toPath(newPath));
}

inline void renameSync(const char* oldPath, const char* newPath) {
    renameSync(String(oldPath), String(newPath));
}

// copyFileSync
inline void copyFileSync(const String& src, const String& dest) {
    std::filesystem::copy_file(toPath(src), toPath(dest), std::filesystem::copy_options::overwrite_existing);
}

inline void copyFileSync(const char* src, const char* dest) {
    copyFileSync(String(src), String(dest));
}

// truncateSync
inline void truncateSync(const String& path, int64_t len = 0) {
    auto p = toPath(path);
    std::filesystem::resize_file(p, static_cast<std::uintmax_t>(len));
}

inline void truncateSync(const char* path, int64_t len = 0) {
    truncateSync(String(path), len);
}

// unlinkSync
inline void unlinkSync(const String& path) {
    std::filesystem::remove(toPath(path));
}

inline void unlinkSync(const char* path) {
    unlinkSync(String(path));
}

// createReadStream/createWriteStream (simplified)
inline Vector<double> createReadStream(const String& path) {
    return readFileSyncBinary(path);
}

inline void createWriteStream(const String& path, const Vector<double>& data) {
    writeFileSyncBinary(path, data);
}

// Buffer variants
inline Vector<double> readFileSyncBuffer(const String& path) {
    return readFileSyncBinary(path);
}

inline Vector<double> readFileSyncBuffer(const char* path) {
    return readFileSyncBinary(String(path));
}

inline void writeFileSyncBuffer(const String& path, const Vector<double>& data) {
    writeFileSyncBinary(path, data);
}

inline void writeFileSyncBuffer(const char* path, const Vector<double>& data) {
    writeFileSyncBinary(String(path), data);
}

// cwd
inline String cwd() {
    return String(std::filesystem::current_path().string());
}

// path utilities
inline String basename(const String& path) {
    return String(toPath(path).filename().string());
}

inline String dirname(const String& path) {
    return String(toPath(path).parent_path().string());
}

inline String extname(const String& path) {
    return String(toPath(path).extension().string());
}

inline String join(const String& a, const String& b) {
    return String((toPath(a) / toPath(b)).string());
}

}  // namespace typoly_std_fs
